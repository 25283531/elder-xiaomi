CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=1024
CONFIG_COMPILER_CXX_RTTI=y

CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=2048

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
# 证书包是**硬依赖**，显式钉住，不靠 IDF 的隐式默认：
#   - OTA / WS 走 esp-ml307 的 esp_ssl.cc（crt_bundle_attach）
#   - 心跳 /api/device/sync 走 components/elder/src/net.c（同上）
# 少了它，https://152.136.230.132 在 esp-tls 建连前就报
# "No server verification option set in esp_tls_cfg_t structure"。
# 2026-10-20 真机事故就卡在这里，症状是「能说话、后台永远离线」。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y

# These entries are copied from ESP-HI (ESP32C3) to reduce memory usage
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# Fix ML307 FIFO Overflow
CONFIG_UART_ISR_IN_IRAM=y

# Fix ESP_SSL error
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n

# LVGL 9.2.2

CONFIG_LV_OS_NONE=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_IMGFONT=y
CONFIG_LV_USE_ASSERT_STYLE=y

# Use compressed font
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_COMPRESSED=n
CONFIG_LV_USE_FONT_PLACEHOLDER=n
CONFIG_LV_USE_LODEPNG=y

# Disable extra widgets to save flash size
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CALENDAR_HEADER_ARROW=n
CONFIG_LV_USE_CALENDAR_HEADER_DROPDOWN=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n

CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n


# --- 立创·实战派 ESP32-S3 ---
CONFIG_BOARD_TYPE_LICHUANG_DEV_S3=y
CONFIG_USE_DEVICE_AEC=y

# >>> BEGIN elder-companion overlay (由 tools/merge_to_xiaozhi.py 注入，勿手改) >>>
# 目标板卡：立创·实战派 ESP32-S3
CONFIG_BOARD_TYPE_LICHUANG_DEV_S3=y
#
# 显示风格：标准 LVGL 界面（SpiLcdDisplay），**不要**开 CONFIG_USE_EMOTE_MESSAGE_STYLE。
#
# 为什么放弃 emote（esp_emote_gfx + EAF 序列帧）形象：真机烧录后屏幕全黑，串口刷
#   gfx_label: FreeType font detected but support is not enabled
#   gfx_label: font context is NULL
#   LichuangDevBoard: Touch display is not initialized
# 根因链（已在本仓库源码上逐条核对）：
#   1) EmoteDisplay 走的是 esp_emote_gfx 自绘引擎（gfx_emote_init），**根本不创建
#      LVGL display**，也不调用 lv_init()。所以 lichuang_dev_board.cc:194 的
#      lv_display_get_default() 必然返回 NULL —— 触摸屏那条报错是 emote 路径的
#      固有产物，不是 LCD 初始化失败。
#   2) 文字渲染走 gfx_draw_label.c:137 的 gfx_is_lvgl_font() 判断，判断失败就把
#      font_ctx 置 NULL（:143-145），之后每次画字都报 "font context is NULL"。
#   3) 实测本仓字体**不是** FreeType 字体，开 CONFIG_GFX_FONT_FREETYPE_SUPPORT 无效：
#      · assets 里的 font_puhui_common_20_4.bin（1,240,332 B）头部就是 lv_font_t：
#        line_height=25 / base_line=6 / dsc=36 / cmap_num=27 / bpp=4，
#        与编译进固件的 font_puhui_basic_20_4.c（line_height=25, base_line=6,
#        cmap_num=7）完全同构 ⇒ gfx_is_lvgl_font() 返回 **true**，
#        压根不会进 #else 的 FreeType 分支；
#      · FreeType 分支只服务 gfx_label_new_font() 载入的内存 TTF，xiaozhi 从未调用。
#      开它只会白白把 FreeType 库编进固件（Flash 变大），症状不变。
# 改回 emote 只需把下面这行换成 CONFIG_USE_EMOTE_MESSAGE_STYLE=y（但要先把上面
# 第 1) 条的 lv_init/LVGL display 缺失和第 2) 条的字体判定一起修掉，否则依旧黑屏）。
CONFIG_USE_DEFAULT_MESSAGE_STYLE=y
# 摄像头已删除（2026-10-22 用户确认不用）——CONFIG_CAMERA_GC0308 及
# esp_video / esp_cam_sensor / esp_new_jpeg / esp_image_effects 依赖全部移除。
# 与后端 TZ=Asia/Shanghai 对齐的提示音语言
CONFIG_LANGUAGE_ZH_CN=y
# 16MB Flash + Octal PSRAM（立创·实战派 N16R8）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# 分区表：v2/16m.csv（含 8MB assets 分区，存放 EAF 形象包 + 唤醒模型）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
# --- 唤醒：回归上游小智（2026-10-20 用户拍板）---
# 放弃自研 dual_wake_word/MultiNet 离线命令词，唤醒/对话/发声全用上游原生。
# 唤醒词 = 「你好小智」（上游 WakeNet 默认 wn9_nihaoxiaozhi_tts）。
# 这里**不覆盖** CONFIG_USE_CUSTOM_WAKE_WORD / CONFIG_CUSTOM_WAKE_WORD /
# CONFIG_SR_WN_* / CONFIG_SR_MN_* —— 让 Kconfig 默认 USE_AFE_WAKE_WORD（S3+SPIRAM）
# 接管。上游 sdkconfig.defaults.esp32s3 自带 CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y，
# 正是「你好小智」的模型，与本次回归一致，不要再删。
# 离线命令词（elder_cmd/elder_mn/custom_wake_word）已删除，NVS 离线提醒
# 引擎（reminder.c 到点播报）保留。
#
# --- 降噪：关闭（2026-11-04 最终结论，别再动）---
#
# 事实链，每一环都有真机证据：
#
# 1. 10-31 选了 SR_NSN_NSNET2，以为"模型进 model 列表就能开降噪"。不成立：
#    本机分区表（partitions/v2/16m.csv）只有 nvs/otadata/phy_init/ota_0/
#    ota_1/assets，**没有 `model` 分区** ⇒ esp_srmodel_init("model") 拿到空
#    列表 ⇒ esp_srmodel_filter 恒为 nullptr ⇒ 那条分支永远走不到。
#
# 2. 11-04 上午改成"算法降噪"：ns_init=true + AFE_NS_MODE_WEBRTC +
#    ns_model_name="WEBRTC"（照 esp_afe_config.h 那句注释抄的）
#    ⇒ **唤醒后设备必重启**（连试三次三次重启，LoadProhibited）。
#
# 3. 11-04 上午再改成 ns_model_name=nullptr，以为"算法降噪不挂模型名就行"
#    ⇒ **仍然唤醒就重启**。用 xiaozhi.map 解 backtrace，崩点还在
#    esp_afe_handle_from_config 里面，第二条 AFE 管线从未建起来。
#
# ⇒ 真正的根因（查库得到，不是猜）：**这份预编译 esp-sr 里没有 WebRTC 降噪
#   实现**。全组件只有一个 libnsnet.a、一个入口 esp_nsnet_handle_from_name，
#   WebRtcNs_Create / WebRtcNsx_Process / NsHandle 这类符号在 libnsnet.a 与
#   libesp_audio_front_end.a 里都不存在。所以 ns_init=true 只能走 NSNet2，
#   而 NSNet2 要 model 分区 ⇒ 拿不到句柄 ⇒ 崩。**跟模型名怎么写无关。**
#
# ⇒ Kconfig 这个 choice 是**惰性的**：CMakeLists.txt 无条件只链一个
#   libnsnet.a，选 WEBRTC 还是 NSNET2 产物完全一样。这里保留组件默认值
#   （WEBRTC），但**不要**因为看到它就以为降噪是开的 —— 代码里是
#   ns_init=false，开机管线上不会有 |NS(...)|。
#
# ⇒ 要在本机真开降噪，前提是给固件加 model 分区（红线 C14，要动分区表），
#   不是改配置能解决的。而且降噪未必划算：esp-sr 自己写着
#   "Noise Supression may reduce the accuracy of speech recognition.
#    It is not recommended to turn it on."；实测 SNR ≈ 37 dB，本机的病是
#   **电平偏低**（峰值 -29 dBFS），那是 AGC 的事，不是降噪的事。
#
# ⚠️ 验证 AGC 只能看开机日志里**第二条** AFE 管线（特征是有
#    `AEC(VOIP_HIGH_PERF)`），它必须打出 `|AGC(WebRTC)|`。第一条是 WakeNet
#    自己建的，与这里无关 —— 只看第一条会得出"没生效"的错误结论（踩过）。
CONFIG_SR_NSN_WEBRTC=y
# 业务后端地址（2026-10-18 起 IP 直连：域名未备案被厂商按 SNI 阻断，
# 连 IP 不带 SNI 可绕过；服务端配 IP 证书后可开证书校验，见 Kconfig 帮助）
CONFIG_ELDER_SERVER_URL="https://152.136.230.132"
CONFIG_ELDER_SERVER_TOKEN=""
CONFIG_ELDER_SYNC_INTERVAL_SEC=300
CONFIG_ELDER_HTTP_TIMEOUT_MS=8000
# 立创板无板载 WS2812；用户已外接 WS2812B 灯珠（DIN→GPIO10），打开。
# ⚠️ 5V 供电时 DIN 的 Vih 典型 0.7×VDD≈3.5V，高于 ESP32-S3 的 3.3V ——
#    处在临界值以下，表现是偶发乱色/闪一下就灭/整条不亮且时好时坏。
#    三种可靠做法（74HCT245 电平转换 / VDD 串肖特基降到 4.4V / 灯带供 3.3V）
#    见 Kconfig 里 ELDER_ENABLE_RGB 的 help。
CONFIG_ELDER_ENABLE_RGB=y
# --- 引脚：产品级换板只改这里，不改代码（2026-10-20）---
# GH1.25 5P 扩展口只引出 GPIO10/11 两根信号线：彩灯 10、按键 11。
# ⚠️ 不要把 ELDER_KEY_GPIO 填回 0：GPIO0 是 BOOT 键，被自动下载电路接管，
#    与上游 xiaozhi 的按键语义双触发，USB 无主机时还会被持续拉低。
CONFIG_ELDER_KEY_GPIO=11
CONFIG_ELDER_RGB_GPIO=10
# 外部时钟：**当前不接**（2026-10-26 用户决定舍弃 DS1302 硬件）。
# 曾经接过 DS1302（三线同步串行 CE/SCLK/DAT，软件 bit-bang），驱动留在
# components/elder/src/rtc_ds1302.c，由 ELDER_RTC_DRIVER 选择，随时可开。
# ⚠️ 若哪天重新接，**绝不能把 CLK/DAT 接到 GPIO1/GPIO2** —— 那是板载音频
#    codec(ES8311/ES7210) 与触摸屏(FT5x06) 共用的 I2C 总线（SDA=1/SCL=2）。
#    DS1302 不是 I2C 器件，bit-bang 会与触摸轮询持续抢总线，后果是 codec
#    寄存器被写坏、触摸失灵，听感上就是破音/卡顿/断续（用户的硬约束是
#    「声音现在正常，千万不要再修的破音、卡顿」）。
#    推荐走线：CLK→GPIO4、DAT→GPIO5、RST→GPIO6（RST 不能占 GPIO11，
#    那是老人服药确认键 ELDER_KEY_GPIO）。prebuild_check 的 C11 会拦这条红线。
CONFIG_ELDER_RTC_ENABLE=n
CONFIG_ELDER_RTC_I2C_PORT=1
# 无 RTC 时用 NVS 里的上次校时 epoch 兜底，避免掉电重启后当天提醒一条不响。
# 注意这是近似时间（关机时长未知），联网后立刻校正。
CONFIG_ELDER_TIME_NVS_FALLBACK=y
# 演示提醒数据（无后端联调时可临时打开）
CONFIG_ELDER_DEMO_DATA=n
# xiaozhi 的 OTA/WS 地址由后端 /api/device/sync 下发，此处保持默认即可
# <<< END elder-companion overlay <<<
